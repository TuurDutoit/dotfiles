{
  "name": "visual-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/cli.ts mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "ui:check": "tsc -p web/tsconfig.json --noEmit",
    "ui:build": "vite build --config web/vite.config.ts",
    "ui:dev": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.7"
  }
}

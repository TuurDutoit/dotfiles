{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "datacamp-internal-cloudflare-mcp": {
      "type": "remote",
      "url": "https://mcp-gateway-internal.datacamp.com/mcp",
      "enabled": true
    },
    "circleci": {
      "type": "remote",
      "url": "https://mcp.circleci.com/v1/mcp"
    },
    "incident-io": {
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true
    },
    "datadog": {
      "enabled": false
    },
    "better-artifacts": {
      "enabled": false
    },
    "airtable": {
      "enabled": false
    },
    "clickup": {
      "enabled": false
    },
    "cloudflare": {
      "enabled": false
    },
    "huggingface": {
      "enabled": false
    },
    "intercom": {
      "enabled": false
    },
    "linear": {
      "enabled": false
    },
    "miro": {
      "enabled": false
    },
    "notion": {
      "enabled": false
    },
    "webflow": {
      "enabled": false
    }
  },
  "tools": {
    "incident-io_*": false,
    "incident_io_*": false,
    "postman_*": false,
    "mcp-internal-tooling_*": false,
    "chrome-devtools_*": false,
    "circleci_*": false,
    "sentry_*": false,
    "atlassian_*": false
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.example": "allow",
      "*.sample": "allow"
    },
    "external_directory": {
      "~/Documents/Obsidian/DataCamp/Agents/**": "allow",
      "/tmp/**": "allow",
      "~/Projects/**": "allow"
    }
  },
  "plugin": [
    "@datacamp/opencode-auto-approve",
    "@datacamp/opencode-openrouter-usage"
  ]
}

{
  "$schema": "https://opencode.ai/config.json",
  // Machine-wide defaults (model, providers, provider policies, share,
  // instructions, and the company MCP servers) come from the managed config:
  // the MDM profile at /Library/Managed Preferences/tuur/ai.opencode.managed.plist
  // and /Library/Application Support/opencode/opencode.json. OpenCode loads
  // them with the highest precedence, so only personal settings belong here.
  "experimental": {
    "subagent_depth": 3
  },
  "mcp": {
    "servers": {
      "datacamp-internal-cloudflare-mcp": {
        "type": "remote",
        "url": "https://mcp-gateway-internal.datacamp.com/mcp"
      },
      "circleci": {
        "type": "remote",
        "url": "https://mcp.circleci.com/v1/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics"
        ]
      },
      "orchestra": {
        "type": "remote",
        "url": "http://127.0.0.1:4777/mcp",
        "oauth": false
      },
      "one-password": {
        "type": "local",
        "command": [
          "1password-mcp"
        ]
      },
      "sonarqube": {
        "type": "remote",
        "url": "https://api.sonarcloud.io/mcp",
        "headers": {
          "Authorization": "Bearer {env:SONARQUBE_MCP_TOKEN}",
          "SONARQUBE_ORG": "datacamp-engineering"
        }
      }
    }
  },
  // Managed integrations that are not used here. They cannot be turned off
  // with "disabled": the managed config has higher precedence and replaces the
  // whole server object. A policy deny removes the integration however it was
  // configured.
  "policies": [
    { "action": "integration.use", "resource": "plugin:@datacamp/opencode-openrouter-usage", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:airtable", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:atlassian", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:better-artifacts", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:clickup", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:datadog", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:huggingface", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:incident-io", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:intercom", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:linear", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:mcp-internal-tooling", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:miro", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:notion", "effect": "deny" },
    { "action": "integration.use", "resource": "mcp:webflow", "effect": "deny" }
  ],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.example", "effect": "allow" },
    { "action": "read", "resource": "*.sample", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "review-dimension", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/tuur/Documents/Obsidian/DataCamp/Agents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/Users/tuur/Projects/**", "effect": "allow" },
  ],
  "agents": {
    // Disable built-in agents, so their permissions "reset".
    // They are recreated later on in the loading sequence by the Markdown definitions.
    "explore": {"disabled": true},
    "build": {"disabled": true},
    "general": {"disabled": true},
  }
}
